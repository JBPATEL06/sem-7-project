{
  "name": "db-context-indexer",
  "version": "0.2.0",
  "description": "Zero-AI-API static-analysis CLI tool and package for MongoDB, Firebase, Supabase, and MySQL detection and cross-file linkage",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "dbci": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "tsup && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "static-analysis",
    "mongodb",
    "firebase",
    "supabase",
    "mysql",
    "ast",
    "indexer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-manager/core": "*",
    "@modelcontextprotocol/sdk": "^1.5.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "googleapis": "^173.0.0",
    "sql.js": "^1.12.0",
    "ts-morph": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/sql.js": "^1.4.9",
    "tsup": "^8.1.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
